rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // GLOBAL DEFAULT DENY CATCH-ALL
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // REUSABLE HELPER PRIMITIVES
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'syedmdshahzaibmas@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // Checks if patient explicitly granted active consent to the requesting doctor
    function hasDoctorPatientConsent(patientId, doctorId) {
      return exists(/databases/$(database)/documents/record_access_grants/$(patientId + '_' + doctorId)) &&
             get(/databases/$(database)/documents/record_access_grants/$(patientId + '_' + doctorId)).data.status == 'active';
    }

    // ==========================================
    // USER PROFILES
    // ==========================================
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
                       incoming().uid == request.auth.uid &&
                       incoming().role in ['patient', 'doctor', 'admin'];
      allow update: if isOwner(userId) &&
                       incoming().uid == existing().uid &&
                       incoming().role == existing().role;
      allow delete: if isAdmin();
    }

    // ==========================================
    // DOCTOR DIRECTORY PROFILES & CREDENTIALS
    // ==========================================
    match /doctor_profiles/{doctorId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      // Doctor can create profile initially as unverified
      allow create: if isOwner(doctorId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().isVerified == false &&
                       incoming().verificationStatus == 'pending';
      // Doctor can update their own bio, hours, fee, but CANNOT verify themselves
      allow update: if (isOwner(doctorId) &&
                        incoming().userId == existing().userId &&
                        !incoming().diff(existing()).affectedKeys().hasAny(['isVerified', 'verificationStatus'])) ||
                       isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // APPOINTMENTS
    // ==========================================
    match /appointments/{appointmentId} {
      allow get: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid
      );
      allow create: if isSignedIn() &&
                       incoming().patientId == request.auth.uid &&
                       incoming().status in ['requested', 'confirmed'];
      allow update: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.patientId == request.auth.uid && resource.data.status == 'requested');
    }

    // ==========================================
    // PATIENT HEALTH TIMELINE & MEDICAL RECORDS
    // ZERO-TRUST CLINICAL ISOLATION:
    // Administrators are intentionally forbidden from casual clinical browsing!
    // Doctors MUST have active patient-directed consent grant.
    // ==========================================
    match /medical_records/{recordId} {
      allow get: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        hasDoctorPatientConsent(resource.data.patientId, request.auth.uid)
      );
      allow list: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        hasDoctorPatientConsent(resource.data.patientId, request.auth.uid)
      );
      allow create: if isSignedIn() && (
        (incoming().patientId == request.auth.uid) ||
        (incoming().doctorId == request.auth.uid && hasDoctorPatientConsent(incoming().patientId, request.auth.uid))
      );
      allow update: if isSignedIn() && (
        (resource.data.patientId == request.auth.uid && incoming().patientId == existing().patientId) ||
        (resource.data.doctorId == request.auth.uid && hasDoctorPatientConsent(resource.data.patientId, request.auth.uid))
      );
      allow delete: if isSignedIn() && resource.data.patientId == request.auth.uid;
    }

    // ==========================================
    // RECORD ACCESS GRANTS (PATIENT-DIRECTED CONSENT)
    // ==========================================
    match /record_access_grants/{grantId} {
      allow get: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid
      );
      // ONLY the patient who owns the records can grant, update, or revoke access!
      allow create: if isSignedIn() && incoming().patientId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.patientId == request.auth.uid &&
                       incoming().patientId == existing().patientId;
      allow delete: if isSignedIn() && resource.data.patientId == request.auth.uid;
    }

    // ==========================================
    // IMMUTABLE AUDIT LOGS
    // ==========================================
    match /audit_logs/{logId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      // Any authenticated user can append an auditable record of their action
      allow create: if isSignedIn() &&
                       incoming().actorId == request.auth.uid &&
                       incoming().keys().hasAll(['timestamp', 'actorId', 'actorRole', 'action', 'details']);
      allow update, delete: if false; // Audit records are immutable
    }

    // Admins registry collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Managed through secure GCP console or seed scripts
    }
  }
}
